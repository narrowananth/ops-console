#!/bin/sh
# Runs the bundled Node from this version's folder; the system Node is never used.
set -eu
self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd -P)
case ${1:-} in
  daemon) exec "$root/node/bin/node" "$root/app/main.js" ;;
  # The daemon bundle carries the Keychain module; the CLI bundle does not.
  mcp-exec) exec "$root/node/bin/node" "$root/app/main.js" "$@" ;;
esac
exec "$root/node/bin/node" "$root/cli/ops-console.js" "$@"

#!/bin/sh
# Runs the bundled Node from this version's folder; the system Node is never used.
set -eu
self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd -P)
# Keychain calls that wait for a password hold a thread each; the pool must outlast a few of them.
export UV_THREADPOOL_SIZE=${UV_THREADPOOL_SIZE:-16}
case ${1:-} in
  daemon)
    export NODE_COMPILE_CACHE=${NODE_COMPILE_CACHE:-$root/../../compile-cache}
    exec "$root/node/bin/node" "$root/app/main.js"
    ;;
  # Small entry with the Keychain and the launcher only, not the whole daemon bundle.
  mcp-exec)
    shift
    exec "$root/node/bin/node" "$root/app/mcp-exec.js" "$@"
    ;;
  # The Google bridge: MCP tools over Google's REST APIs, with no daemon and no Keychain of its own.
  google-mcp)
    shift
    exec "$root/node/bin/node" "$root/app/google-mcp.js" "$@"
    ;;
  mcp-setup) exec "$root/node/bin/node" "$root/app/main.js" "$@" ;;
esac
exec "$root/node/bin/node" "$root/cli/ops-console.js" "$@"

{
  "name": "ops-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ops-console/backend --filter @ops-console/frontend dev",
    "dev:open": "node scripts/dev-open.mjs",
    "build": "pnpm -r build",
    "check": "biome check . && pnpm -r typecheck && pnpm -r --workspace-concurrency=1 test",
    "db:generate": "pnpm --filter @ops-console/backend db:generate",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}

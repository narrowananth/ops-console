{
  "name": "@ops-console/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "OPS_CONSOLE_APP_DIR=. OPS_CONSOLE_DATA_DIR=.data OPS_CONSOLE_PORT=4546 tsx watch src/main.ts",
    "build": "node scripts/build.mjs",
